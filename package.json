{
  "name": "api-troubleshooting-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "tsx tests/helpers/assert-test-env.ts && vitest run --config vitest.integration.config.ts",
    "test:e2e": "tsx tests/helpers/assert-test-env.ts && playwright test",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:full": "tsx tests/helpers/full-test.ts",
    "test:full:cleanup": "tsx tests/helpers/cleanup-full-run.ts",
    "test:live-llm": "cross-env RUN_LIVE_LLM_TESTS=1 vitest run tests/contract/dashscope-live.test.ts",
    "test:live-diagnosis": "tsx src/db/run-live-diagnosis.ts",
    "test:live-diagnosis:token-limit": "cross-env LIVE_DIAGNOSIS_SCENARIO=token-limit npm run test:live-diagnosis",
    "eval:diagnosis": "tsx src/eval-diagnosis.ts",
    "test:db:reset": "tsx tests/helpers/db-reset.ts",
    "db:test:prepare": "tsx src/db/create-test-db.ts",
    "db:test:verify": "tsx src/db/verify-test-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "evidence:cleanup": "tsx src/db/sweep-evidence.ts",
    "db:seed": "tsx src/db/seed.ts",
    "knowledge:clean": "tsx src/db/clean-knowledge.ts",
    "knowledge:import": "tsx src/db/import-knowledge.ts",
    "worker": "tsx watch src/worker.ts",
    "dev-all": "concurrently --kill-others-on-fail --names web,worker --prefix-colors cyan,magenta npm:dev npm:worker"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "pg": "^8.13.1",
    "pg-boss": "^12.33.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "caniuse-lite": "^1.0.30001650",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.28.1",
    "es-abstract": "^1.23.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
